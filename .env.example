# Threat Intelligence API Keys (used by Python CLI and web workbench)
VT_API_KEY=your_virustotal_api_key
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
OTX_API_KEY=your_alienvault_otx_api_key

# Additional Threat Intelligence API Keys (configured server-side via .env)
SHODAN_API_KEY=your_shodan_api_key
THREATFOX_AUTH_KEY=your_threatfox_auth_key
URLSCAN_API_KEY=your_urlscan_api_key
# Custom threat intelligence integrations reference any uppercase env var name configured in CLI & APIs:
# CUSTOM_THREAT_API_KEY=your_custom_provider_api_key

# Optional SMTP configuration for threshold-based IOC email alerts (server-side only)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=alerts@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=soti-alerts@example.com

# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
